{
    "properties":  {
                       "connectionReferences":  {
                                                    "shared_commondataserviceforapps":  {
                                                                                            "runtimeSource":  "embedded",
                                                                                            "connection":  {
                                                                                                               "connectionReferenceLogicalName":  "cczd_dataverse"
                                                                                                           },
                                                                                            "api":  {
                                                                                                        "name":  "shared_commondataserviceforapps"
                                                                                                    }
                                                                                        }
                                                },
                       "definition":  {
                                          "$schema":  "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                                          "contentVersion":  "1.0.0.0",
                                          "parameters":  {
                                                             "$connections":  {
                                                                                  "defaultValue":  {

                                                                                                   },
                                                                                  "type":  "Object"
                                                                              },
                                                             "$authentication":  {
                                                                                     "defaultValue":  {

                                                                                                      },
                                                                                     "type":  "SecureObject"
                                                                                 },
                                                             "Zendesk Subdomain (cczd_ZendeskSubdomain)":  {
                                                                                                               "defaultValue":  "",
                                                                                                               "type":  "String",
                                                                                                               "metadata":  {
                                                                                                                                "schemaName":  "cczd_ZendeskSubdomain"
                                                                                                                            }
                                                                                                           },
                                                             "Zendesk OAuth Client ID (cczd_ZendeskClientId)":  {
                                                                                                                    "defaultValue":  "",
                                                                                                                    "type":  "String",
                                                                                                                    "metadata":  {
                                                                                                                                     "schemaName":  "cczd_ZendeskClientId"
                                                                                                                                 }
                                                                                                                },
                                                             "Zendesk OAuth Client Secret (cczd_ZendeskClientSecret)":  {
                                                                                                                            "defaultValue":  "",
                                                                                                                            "type":  "String",
                                                                                                                            "metadata":  {
                                                                                                                                             "schemaName":  "cczd_ZendeskClientSecret"
                                                                                                                                         }
                                                                                                                        },
                                                             "D365 Environment URL (cczd_D365OrgUrl)":  {
                                                                                                            "defaultValue":  "",
                                                                                                            "type":  "String",
                                                                                                            "metadata":  {
                                                                                                                             "schemaName":  "cczd_D365OrgUrl"
                                                                                                                         }
                                                                                                        }
                                                         },
                                          "triggers":  {
                                                           "When_a_voice_conversation_ends":  {
                                                                                                  "type":  "OpenApiConnectionWebhook",
                                                                                                  "inputs":  {
                                                                                                                 "host":  {
                                                                                                                              "connectionName":  "shared_commondataserviceforapps",
                                                                                                                              "apiId":  "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                                                                                                              "operationId":  "SubscribeWebhookTrigger"
                                                                                                                          },
                                                                                                                 "parameters":  {
                                                                                                                                    "subscriptionRequest/message":  3,
                                                                                                                                    "subscriptionRequest/entityname":  "msdyn_ocliveworkitem",
                                                                                                                                    "subscriptionRequest/scope":  4,
                                                                                                                                    "subscriptionRequest/filteringattributes":  "statuscode",
                                                                                                                                    "subscriptionRequest/filterexpression":  "(statuscode eq 4 or statuscode eq 5)"
                                                                                                                                },
                                                                                                                 "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                             }
                                                                                              }
                                                       },
                                          "actions":  {
                                                          "Get_conversation":  {
                                                                                   "runAfter":  {

                                                                                                },
                                                                                   "type":  "OpenApiConnection",
                                                                                   "inputs":  {
                                                                                                  "host":  {
                                                                                                               "connectionName":  "shared_commondataserviceforapps",
                                                                                                               "apiId":  "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                                                                                               "operationId":  "GetItem"
                                                                                                           },
                                                                                                  "parameters":  {
                                                                                                                     "entityName":  "msdyn_ocliveworkitems",
                                                                                                                     "recordId":  "@triggerOutputs()?[\u0027body/activityid\u0027]",
                                                                                                                     "$select":  "msdyn_channel,msdyn_conversationtalktimeinseconds,msdyn_conversationfirstwaittimeinseconds,msdyn_conversationhandletimeinseconds,msdyn_customersentimentlabel,msdyn_copilotengaged"
                                                                                                                 },
                                                                                                  "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                              }
                                                                               },
                                                          "If_voice_call":  {
                                                                                "runAfter":  {
                                                                                                 "Get_conversation":  [
                                                                                                                          "Succeeded"
                                                                                                                      ]
                                                                                             },
                                                                                "type":  "If",
                                                                                "expression":  {
                                                                                                   "and":  [
                                                                                                               {
                                                                                                                   "equals":  [
                                                                                                                                  "@string(body(\u0027Get_conversation\u0027)?[\u0027msdyn_channel\u0027])",
                                                                                                                                  "192440000"
                                                                                                                              ]
                                                                                                               }
                                                                                                           ]
                                                                                               },
                                                                                "actions":  {
                                                                                                "Wait_for_AI_evaluation":  {
                                                                                                                               "runAfter":  {

                                                                                                                                            },
                                                                                                                               "type":  "Wait",
                                                                                                                               "inputs":  {
                                                                                                                                              "interval":  {
                                                                                                                                                               "count":  2,
                                                                                                                                                               "unit":  "Minute"
                                                                                                                                                           }
                                                                                                                                          }
                                                                                                                           },
                                                                                                "Get_quality_evaluation":  {
                                                                                                                               "runAfter":  {
                                                                                                                                                "Wait_for_AI_evaluation":  [
                                                                                                                                                                               "Succeeded"
                                                                                                                                                                           ]
                                                                                                                                            },
                                                                                                                               "type":  "OpenApiConnection",
                                                                                                                               "inputs":  {
                                                                                                                                              "host":  {
                                                                                                                                                           "connectionName":  "shared_commondataserviceforapps",
                                                                                                                                                           "apiId":  "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                                                                                                                                           "operationId":  "ListRecords"
                                                                                                                                                       },
                                                                                                                                              "parameters":  {
                                                                                                                                                                 "entityName":  "msdyn_evaluationhistories",
                                                                                                                                                                 "$select":  "msdyn_evaluationscore,msdyn_responsejson,createdon",
                                                                                                                                                                 "$filter":  "msdyn_ocliveworkitemid eq \u0027@{triggerOutputs()?[\u0027body/activityid\u0027]}\u0027",
                                                                                                                                                                 "$orderby":  "createdon desc",
                                                                                                                                                                 "$top":  1
                                                                                                                                                             },
                                                                                                                                              "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                                                          }
                                                                                                                           },
                                                                                                "Get_Zendesk_token":  {
                                                                                                                          "runAfter":  {
                                                                                                                                           "Get_quality_evaluation":  [
                                                                                                                                                                          "Succeeded",
                                                                                                                                                                          "Failed"
                                                                                                                                                                      ]
                                                                                                                                       },
                                                                                                                          "type":  "Http",
                                                                                                                          "inputs":  {
                                                                                                                                         "method":  "POST",
                                                                                                                                         "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/oauth/tokens",
                                                                                                                                         "headers":  {
                                                                                                                                                         "Content-Type":  "application/json",
                                                                                                                                                         "Accept":  "application/json"
                                                                                                                                                     },
                                                                                                                                         "body":  {
                                                                                                                                                      "grant_type":  "client_credentials",
                                                                                                                                                      "client_id":  "@parameters(\u0027Zendesk OAuth Client ID (cczd_ZendeskClientId)\u0027)",
                                                                                                                                                      "client_secret":  "@parameters(\u0027Zendesk OAuth Client Secret (cczd_ZendeskClientSecret)\u0027)",
                                                                                                                                                      "scope":  "read write"
                                                                                                                                                  }
                                                                                                                                     }
                                                                                                                      },
                                                                                                "Find_ticket":  {
                                                                                                                    "runAfter":  {
                                                                                                                                     "Get_Zendesk_token":  [
                                                                                                                                                               "Succeeded"
                                                                                                                                                           ]
                                                                                                                                 },
                                                                                                                    "type":  "Http",
                                                                                                                    "inputs":  {
                                                                                                                                   "method":  "GET",
                                                                                                                                   "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/api/v2/tickets.json?external_id=@{triggerOutputs()?[\u0027body/activityid\u0027]}",
                                                                                                                                   "headers":  {
                                                                                                                                                   "Accept":  "application/json",
                                                                                                                                                   "Authorization":  "Bearer @{body(\u0027Get_Zendesk_token\u0027)?[\u0027access_token\u0027]}"
                                                                                                                                               }
                                                                                                                               }
                                                                                                                },
                                                                                                "If_ticket_found":  {
                                                                                                                        "runAfter":  {
                                                                                                                                         "Find_ticket":  [
                                                                                                                                                             "Succeeded"
                                                                                                                                                         ]
                                                                                                                                     },
                                                                                                                        "type":  "If",
                                                                                                                        "expression":  {
                                                                                                                                           "and":  [
                                                                                                                                                       {
                                                                                                                                                           "greater":  [
                                                                                                                                                                           "@length(body(\u0027Find_ticket\u0027)?[\u0027tickets\u0027])",
                                                                                                                                                                           0
                                                                                                                                                                       ]
                                                                                                                                                       }
                                                                                                                                                   ]
                                                                                                                                       },
                                                                                                                        "actions":  {
                                                                                                                                        "Update_ticket":  {
                                                                                                                                                              "runAfter":  {

                                                                                                                                                                           },
                                                                                                                                                              "type":  "Http",
                                                                                                                                                              "inputs":  {
                                                                                                                                                                             "method":  "PUT",
                                                                                                                                                                             "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/api/v2/tickets/@{first(body(\u0027Find_ticket\u0027)?[\u0027tickets\u0027])?[\u0027id\u0027]}.json",
                                                                                                                                                                             "headers":  {
                                                                                                                                                                                             "Content-Type":  "application/json",
                                                                                                                                                                                             "Accept":  "application/json",
                                                                                                                                                                                             "Authorization":  "Bearer @{body(\u0027Get_Zendesk_token\u0027)?[\u0027access_token\u0027]}"
                                                                                                                                                                                         },
                                                                                                                                                                             "body":  {
                                                                                                                                                                                          "ticket":  {
                                                                                                                                                                                                         "comment":  {
                                                                                                                                                                                                                         "body":  "Call ended (Dynamics 365 Contact Center)\nTalk time: @{if(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationtalktimeinseconds\u0027], null), \u0027n/a\u0027, concat(string(div(int(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationtalktimeinseconds\u0027]), 60)), \u0027m \u0027, string(mod(int(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationtalktimeinseconds\u0027]), 60)), \u0027s\u0027))} | Wait: @{if(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationfirstwaittimeinseconds\u0027], null), \u0027n/a\u0027, concat(string(div(int(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationfirstwaittimeinseconds\u0027]), 60)), \u0027m \u0027, string(mod(int(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationfirstwaittimeinseconds\u0027]), 60)), \u0027s\u0027))} | Handle: @{if(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationhandletimeinseconds\u0027], null), \u0027n/a\u0027, concat(string(div(int(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationhandletimeinseconds\u0027]), 60)), \u0027m \u0027, string(mod(int(body(\u0027Get_conversation\u0027)?[\u0027msdyn_conversationhandletimeinseconds\u0027]), 60)), \u0027s\u0027))}\nCustomer sentiment: @{coalesce(body(\u0027Get_conversation\u0027)?[\u0027msdyn_customersentimentlabel@OData.Community.Display.V1.FormattedValue\u0027], \u0027n/a\u0027)}\nHandled by virtual agent: @{if(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_copilotengaged\u0027], true), \u0027yes\u0027, \u0027no\u0027)}\nAI quality score: @{coalesce(if(equals(length(coalesce(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027], json(\u0027[]\u0027))), 0), json(\u0027{}\u0027), first(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027]))?[\u0027msdyn_evaluationscore\u0027], \u0027not available yet\u0027)}@{if(equals(json(coalesce(if(equals(length(coalesce(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027], json(\u0027[]\u0027))), 0), json(\u0027{}\u0027), first(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027]))?[\u0027msdyn_responsejson\u0027], \u0027{}\u0027))?[\u0027action_name\u0027], null), \u0027\u0027, concat(\u0027 (\u0027, json(coalesce(if(equals(length(coalesce(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027], json(\u0027[]\u0027))), 0), json(\u0027{}\u0027), first(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027]))?[\u0027msdyn_responsejson\u0027], \u0027{}\u0027))?[\u0027action_name\u0027], \u0027)\u0027))}\nAI summary: @{coalesce(json(coalesce(if(equals(length(coalesce(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027], json(\u0027[]\u0027))), 0), json(\u0027{}\u0027), first(outputs(\u0027Get_quality_evaluation\u0027)?[\u0027body/value\u0027]))?[\u0027msdyn_responsejson\u0027], \u0027{}\u0027))?[\u0027overall_summary\u0027], \u0027not available yet\u0027)}\nRecording and transcript: @{parameters(\u0027D365 Environment URL (cczd_D365OrgUrl)\u0027)}/main.aspx?appname=new_ContactCenterCallReview\u0026pagetype=entityrecord\u0026etn=msdyn_ocliveworkitem\u0026id=@{triggerOutputs()?[\u0027body/activityid\u0027]}",
                                                                                                                                                                                                                         "public":  false
                                                                                                                                                                                                                     },
                                                                                                                                                                                                         "additional_tags":  [
                                                                                                                                                                                                                                 "d365cc-ended"
                                                                                                                                                                                                                             ]
                                                                                                                                                                                                     }
                                                                                                                                                                                      }
                                                                                                                                                                         }
                                                                                                                                                          }
                                                                                                                                    },
                                                                                                                        "else":  {
                                                                                                                                     "actions":  {

                                                                                                                                                 }
                                                                                                                                 }
                                                                                                                    }
                                                                                            },
                                                                                "else":  {
                                                                                             "actions":  {

                                                                                                         }
                                                                                         }
                                                                            }
                                                      },
                                          "outputs":  {

                                                      }
                                      }
                   },
    "schemaVersion":  "1.0.0.0"
}