                                                                                                                                                                                                   "Succeeded"
                                                                                                                                                                                               ]
                                                                                                                                                                             },
                                                                                                                                                                "type":  "Http",
                                                                                                                                                                "inputs":  {
                                                                                                                                                                               "method":  "GET",
                                                                                                                                                                               "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/api/v2/users/search.json?query=email:@{encodeUriComponent(body(\u0027Get_agent\u0027)?[\u0027internalemailaddress\u0027])}",
                                                                                                                                                                               "headers":  {
                                                                                                                                                                                               "Accept":  "application/json",
                                                                                                                                                                                               "Authorization":  "Bearer @{body(\u0027Get_Zendesk_token\u0027)?[\u0027access_token\u0027]}"
                                                                                                                                                                                           }
                                                                                                                                                                           }
                                                                                                                                                            },
                                                                                                                                   "Target_users":  {
                                                                                                                                                        "runAfter":  {
                                                                                                                                                                         "Search_Zendesk_agent":  [
                                                                                                                                                                                                      "Succeeded"
                                                                                                                                                                                                  ]
                                                                                                                                                                     },
                                                                                                                                                        "type":  "Compose",
                                                                                                                                                        "inputs":  "@if(greater(length(body(\u0027Search_Zendesk_agent\u0027)?[\u0027users\u0027]), 0), body(\u0027Search_Zendesk_agent\u0027)?[\u0027users\u0027], body(\u0027List_Zendesk_agents\u0027)?[\u0027users\u0027])"
                                                                                                                                                    },
                                                                                                                                   "If_human_agent":  {
