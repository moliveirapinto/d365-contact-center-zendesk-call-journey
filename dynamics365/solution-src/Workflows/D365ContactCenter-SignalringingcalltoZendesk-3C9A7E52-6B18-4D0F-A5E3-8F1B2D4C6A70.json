                                                                                                                          "Succeeded"
                                                                                                                      ]
                                                                                             },
                                                                                "type":  "If",
                                                                                "expression":  {
                                                                                                   "and":  [
                                                                                                               {
                                                                                                                   "equals":  [
                                                                                                                                  "@string(body(\u0027Get_conversation\u0027)?[\u0027msdyn_channel\u0027])",
                                                                                                                                  "192440000"
                                                                                                                              ]
                                                                                                               }
                                                                                                           ]
                                                                                               },
                                                                                "actions":  {
                                                                                                "Get_Zendesk_token":  {
                                                                                                                          "runAfter":  {

                                                                                                                                       },
                                                                                                                          "type":  "Http",
                                                                                                                          "inputs":  {
                                                                                                                                         "method":  "POST",
                                                                                                                                         "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/oauth/tokens",
                                                                                                                                         "headers":  {
                                                                                                                                                         "Content-Type":  "application/json",
                                                                                                                                                         "Accept":  "application/json"
                                                                                                                                                     },
                                                                                                                                         "body":  {
                                                                                                                                                      "grant_type":  "client_credentials",
                                                                                                                                                      "client_id":  "@parameters(\u0027Zendesk OAuth Client ID (cczd_ZendeskClientId)\u0027)",
                                                                                                                                                      "client_secret":  "@parameters(\u0027Zendesk OAuth Client Secret (cczd_ZendeskClientSecret)\u0027)",
                                                                                                                                                      "scope":  "read write"
                                                                                                                                                  }
                                                                                                                                     }
                                                                                                                      },
                                                                                                "List_Zendesk_agents":  {
                                                                                                                            "runAfter":  {
                                                                                                                                             "Get_Zendesk_token":  [
                                                                                                                                                                       "Succeeded"
                                                                                                                                                                   ]
                                                                                                                                         },
                                                                                                                            "type":  "Http",
                                                                                                                            "inputs":  {
                                                                                                                                           "method":  "GET",
                                                                                                                                           "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/api/v2/users.json?role[]=admin\u0026role[]=agent",
                                                                                                                                           "headers":  {
                                                                                                                                                           "Accept":  "application/json",
                                                                                                                                                           "Authorization":  "Bearer @{body(\u0027Get_Zendesk_token\u0027)?[\u0027access_token\u0027]}"
                                                                                                                                                       }
                                                                                                                                       }
                                                                                                                        },
                                                                                                "If_ringing":  {
                                                                                                                   "runAfter":  {
                                                                                                                                    "List_Zendesk_agents":  [
                                                                                                                                                                "Succeeded"
                                                                                                                                                            ]
                                                                                                                                },
                                                                                                                   "type":  "If",
                                                                                                                   "expression":  {
                                                                                                                                      "and":  [
                                                                                                                                                  {
                                                                                                                                                      "equals":  [
                                                                                                                                                                     "@and(not(equals(coalesce(body(\u0027Get_conversation\u0027)?[\u0027_msdyn_activeagentid_value\u0027], \u0027\u0027), \u0027\u0027)), not(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_activeagentassignedon\u0027], null)), not(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_isagentaccepted\u0027], true)), not(equals(body(\u0027Get_conversation\u0027)?[\u0027msdyn_isabandoned\u0027], true)), not(equals(body(\u0027Get_conversation\u0027)?[\u0027statuscode\u0027], 4)), not(equals(body(\u0027Get_conversation\u0027)?[\u0027statuscode\u0027], 5)))",
                                                                                                                                                                     true
                                                                                                                                                                 ]
                                                                                                                                                  }
                                                                                                                                              ]
                                                                                                                                  },
                                                                                                                   "actions":  {
                                                                                                                                   "Get_agent":  {
                                                                                                                                                     "runAfter":  {

                                                                                                                                                                  },
                                                                                                                                                     "type":  "OpenApiConnection",
                                                                                                                                                     "inputs":  {
                                                                                                                                                                    "host":  {
                                                                                                                                                                                 "connectionName":  "shared_commondataserviceforapps",
                                                                                                                                                                                 "apiId":  "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                                                                                                                                                                 "operationId":  "GetItem"
                                                                                                                                                                             },
                                                                                                                                                                    "parameters":  {
                                                                                                                                                                                       "entityName":  "systemusers",
                                                                                                                                                                                       "recordId":  "@body(\u0027Get_conversation\u0027)?[\u0027_msdyn_activeagentid_value\u0027]",
                                                                                                                                                                                       "$select":  "internalemailaddress,accessmode"
                                                                                                                                                                                   },
                                                                                                                                                                    "authentication":  "@parameters(\u0027$authentication\u0027)"
                                                                                                                                                                }
                                                                                                                                                 },
                                                                                                                                   "Search_Zendesk_agent":  {
