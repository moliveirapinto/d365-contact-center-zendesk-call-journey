                                                                                                                                                                                                            0
                                                                                                                                                                                                        ]
                                                                                                                                                                                         }
                                                                                                                                                                                     ]
                                                                                                                                                                         },
                                                                                                                                                          "actions":  {
                                                                                                                                                                          "For_each_target":  {
                                                                                                                                                                                                  "runAfter":  {

                                                                                                                                                                                                               },
                                                                                                                                                                                                  "type":  "Foreach",
                                                                                                                                                                                                  "foreach":  "@outputs(\u0027Target_users\u0027)",
                                                                                                                                                                                                  "actions":  {
                                                                                                                                                                                                                  "Add_ring_tag":  {
                                                                                                                                                                                                                                       "runAfter":  {

                                                                                                                                                                                                                                                    },
                                                                                                                                                                                                                                       "type":  "Http",
                                                                                                                                                                                                                                       "inputs":  {
                                                                                                                                                                                                                                                      "method":  "PUT",
                                                                                                                                                                                                                                                      "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/api/v2/users/@{items(\u0027For_each_target\u0027)?[\u0027id\u0027]}/tags.json",
                                                                                                                                                                                                                                                      "headers":  {
                                                                                                                                                                                                                                                                      "Content-Type":  "application/json",
                                                                                                                                                                                                                                                                      "Accept":  "application/json",
                                                                                                                                                                                                                                                                      "Authorization":  "Bearer @{body(\u0027Get_Zendesk_token\u0027)?[\u0027access_token\u0027]}"
                                                                                                                                                                                                                                                                  },
                                                                                                                                                                                                                                                      "body":  {
                                                                                                                                                                                                                                                                   "tags":  [
                                                                                                                                                                                                                                                                                "d365cc-ring"
                                                                                                                                                                                                                                                                            ]
                                                                                                                                                                                                                                                               }
                                                                                                                                                                                                                                                  }
                                                                                                                                                                                                                                   }
                                                                                                                                                                                                              }
                                                                                                                                                                                              }
                                                                                                                                                                      },
                                                                                                                                                          "else":  {
                                                                                                                                                                       "actions":  {

                                                                                                                                                                                   }
                                                                                                                                                                   }
                                                                                                                                                      }
                                                                                                                               },
                                                                                                                   "else":  {
                                                                                                                                "actions":  {
                                                                                                                                                "For_each_all":  {
                                                                                                                                                                     "runAfter":  {

                                                                                                                                                                                  },
                                                                                                                                                                     "type":  "Foreach",
                                                                                                                                                                     "foreach":  "@body(\u0027List_Zendesk_agents\u0027)?[\u0027users\u0027]",
                                                                                                                                                                     "actions":  {
                                                                                                                                                                                     "Remove_ring_tag":  {
                                                                                                                                                                                                             "runAfter":  {

                                                                                                                                                                                                                          },
                                                                                                                                                                                                             "type":  "Http",
                                                                                                                                                                                                             "inputs":  {
                                                                                                                                                                                                                            "method":  "DELETE",
                                                                                                                                                                                                                            "uri":  "https://@{parameters(\u0027Zendesk Subdomain (cczd_ZendeskSubdomain)\u0027)}.zendesk.com/api/v2/users/@{items(\u0027For_each_all\u0027)?[\u0027id\u0027]}/tags.json",
                                                                                                                                                                                                                            "headers":  {
                                                                                                                                                                                                                                            "Content-Type":  "application/json",
                                                                                                                                                                                                                                            "Accept":  "application/json",
                                                                                                                                                                                                                                            "Authorization":  "Bearer @{body(\u0027Get_Zendesk_token\u0027)?[\u0027access_token\u0027]}"
                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                            "body":  {
                                                                                                                                                                                                                                         "tags":  [
                                                                                                                                                                                                                                                      "d365cc-ring"
                                                                                                                                                                                                                                                  ]
                                                                                                                                                                                                                                     }
                                                                                                                                                                                                                        }
                                                                                                                                                                                                         }
                                                                                                                                                                                 }
                                                                                                                                                                 }
                                                                                                                                            }
                                                                                                                            }
                                                                                                               }
                                                                                            },
                                                                                "else":  {
                                                                                             "actions":  {

                                                                                                         }
                                                                                         }
                                                                            }
                                                      },
                                          "outputs":  {

                                                      }
                                      }
                   },
    "schemaVersion":  "1.0.0.0"
}